# Copy to secrets.env (git-ignored) and change every value; kustomize turns it into the Secret "platform-secrets".
# scripts\windows\k8s-deploy.cmd creates secrets.env from your .env automatically.
POSTGRES_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
ORACLE_PASSWORD=change-me
ORACLE_APP_PASSWORD=change-me
ADMIN_PASSWORD=change-me-to-12-or-more-characters
INTERNAL_API_KEY=change-me-to-a-long-random-string
