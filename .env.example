# Copy to .env (git-ignored) to set the local docker compose secrets.
# scripts\windows\run-local.cmd adds ADMIN_PASSWORD and INTERNAL_API_KEY with random values when they are missing.

# Database passwords (local containers only)
POSTGRES_PASSWORD=postgres
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_PASSWORD=auth_pass
ORACLE_PASSWORD=oracle_admin
ORACLE_APP_PASSWORD=payment_pass

# The one platform administrator signs in to the Control Center (http://localhost:3001) as "admin" with this password.
# Use 12 or more characters. No administrator account exists while it is empty; change it and restart
# auth-service to change the administrator's password.
ADMIN_PASSWORD=

# Shared secret for calls between the services (/internal/**). Any long random string; the same for every service.
INTERNAL_API_KEY=
